# ==============================================================================
# TRACE Backend Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY
# Copy this file to .env for local development
# ==============================================================================

# Application Environment
ENVIRONMENT=development
# Boolean only: true or false. A legacy host value of `release` is treated as false.
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list of permitted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (Supabase / PostgreSQL Compatible)
# Placeholder format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/trace_db

# Supabase Deployment Keys (Placeholders only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key_never_commit_real_secret
SUPABASE_ANON_KEY=placeholder_anon_key_never_commit_real_secret

# Groq Configuration (optional explanations and email drafts only)
# Uses Groq's OpenAI-compatible API; never affects deterministic findings.
GROQ_API_KEY=placeholder_groq_api_key_do_not_commit
AI_EXPLANATIONS_ENABLED=false
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=10

# Rules Engine Configuration
DEFAULT_RULE_VERSION=2026.1.0
CLOCK_SKEW_TOLERANCE_SECONDS=5.0
